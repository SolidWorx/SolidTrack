{% extends 'layouts/base.html.twig' %}

{# Inject into <head> via the stylesheets block (the only head-extension point
   exposed by the platform layout) so Turbo sees it before swap. Without this,
   the url:true LiveProps on <twig:ProjectTimeEntries> make Turbo cache/restore a
   snapshot that duplicates the live-updated DOM on every filter change.
   NOTE: only `no-cache` is used here — do NOT add `turbo-visit-control: reload`,
   which breaks the Cancel button's history.back() (it forces a full reload on the
   restoration visit and bounces the user back to /edit). #}
{% block stylesheets %}
    {{ parent() }}
    <meta name="turbo-cache-control" content="no-cache">
{% endblock %}

{% block page_pretitle %}
    <a href="{{ path('app_project_index') }}" class="text-secondary">
        {{ ux_icon('tabler:arrow-left', {class: 'icon icon-sm'}) }}
        {{ 'Projects'|trans }}
    </a>
{% endblock %}

{% block page_title %}
    <span class="status-dot align-middle me-2" style="--swp-status-color: {{ project.color }}" aria-hidden="true"></span>
    {{ project.name }}
{% endblock %}

{% block page_title_actions %}
    {{ include('components/_manual_entry_button.html.twig', {'project': project}) }}
    <a href="{{ path('app_project_edit', {'id': project.id}) }}" class="btn btn-primary">
        {{ ux_icon('tabler:pencil', {class: 'icon'}) }}
        {{ 'Edit project'|trans }}
    </a>
{% endblock %}

{% block content %}
    <div class="text-secondary d-flex align-items-center flex-wrap gap-2 mb-3">
        {% if project.client %}
            <span>
                {{ ux_icon('tabler:building', {class: 'icon icon-sm'}) }}
                {{ project.client.name }}
            </span>
            <span>·</span>
        {% endif %}
        <twig:InlineRateEdit :project="project" />
    </div>

    <div class="row row-cards mb-3">
        <div class="col-sm-6 col-xl">
            <twig:StatCard :label="'Total tracked'|trans"
                           :hint="'%count% entries'|trans({'%count%': entryCount})">
                <time>{{ format_interval(summary.totalDuration, true) }}</time>
            </twig:StatCard>
        </div>
        <div class="col-sm-6 col-xl">
            <twig:StatCard :label="'Billable'|trans" :hint="'Billable hours'|trans" tone="text-primary">
                <time>{{ format_interval(summary.billableDuration, true) }}</time>
            </twig:StatCard>
        </div>
        <div class="col-sm-6 col-xl">
            <twig:StatCard :label="'Non-billable'|trans" :hint="'Non-billable hours'|trans">
                <time>{{ format_interval(nonBillable, true) }}</time>
            </twig:StatCard>
        </div>
        <div class="col-sm-6 col-xl">
            <twig:StatCard :label="'Earned'|trans" :hint="'All time'|trans">
                {% if summary.amount > 0 and summary.currency %}
                    {{ summary.amount|format_currency(summary.currency) }}
                {% else %}
                    <span class="text-secondary">—</span>
                {% endif %}
            </twig:StatCard>
        </div>
        <div class="col-sm-6 col-xl">
            <twig:StatCard
                :label="'Last activity'|trans"
                :hint="summary.lastActivity ? summary.lastActivity.format('M j, Y') : 'No entries yet'|trans"
                :numeric="false"
            >
                {% if summary.lastActivity %}
                    <span class="fs-2">{{ summary.lastActivity.diffForHumans }}</span>
                {% else %}
                    <span class="text-secondary">—</span>
                {% endif %}
            </twig:StatCard>
        </div>
    </div>

    <twig:ProjectTimeEntries :projectId="project.id" />

    {{ include('components/_manual_entry_modal.html.twig') }}
{% endblock %}
