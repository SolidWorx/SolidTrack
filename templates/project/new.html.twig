{% extends 'layouts/base.html.twig' %}

{% block page_title %}{{ 'Create new project'|trans }}{% endblock %}

{% block content %}
    {{ form_start(form) }}
    <div class="card">
        <div class="card-body">
            {{ form_widget(form) }}
        </div>
        <div class="card-footer d-flex">
            <a href="{{ path('app_project_index') }}" class="btn">
                {{ ux_icon('tabler:arrow-back', {class: 'icon'}) }}
                {{ 'Cancel'|trans }}
            </a>
            <button class="btn btn-primary ms-auto">
                {{ ux_icon('tabler:device-floppy', {class: 'icon'}) }}
                {{ button_label|default('Save') }}
            </button>
        </div>
    </div>
    {{ form_end(form) }}
{% endblock %}
