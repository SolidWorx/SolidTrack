{% if tags is not empty %}
    <div class="d-flex flex-wrap gap-1">
        {% for tag in tags %}
            <span class="badge badge-outline" style="--swp-badge-color: {{ tag.color }}">
                {{ ux_icon('tabler:tag', {class: 'icon'}) }}
                {{ tag.name }}
            </span>
        {% endfor %}
    </div>
{% endif %}
