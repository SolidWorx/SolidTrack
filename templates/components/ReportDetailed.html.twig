<div {{ attributes }}>
    {% include 'components/_report_filters.html.twig' with {showGroupBy: false} %}

    <div class="row row-cards mb-3">
        <div class="col-sm-6 col-xl-3">
            <twig:StatCard :label="'Entries'|trans">{{ totals.count }}</twig:StatCard>
        </div>
        <div class="col-sm-6 col-xl-3">
            <twig:StatCard :label="'Total time'|trans">
                <time>{{ format_interval(totals.total, true) }}</time>
            </twig:StatCard>
        </div>
        <div class="col-sm-6 col-xl-3">
            <twig:StatCard :label="'Billable'|trans" tone="text-primary">
                <time>{{ format_interval(totals.billable, true) }}</time>
            </twig:StatCard>
        </div>
        <div class="col-sm-6 col-xl-3">
            <twig:StatCard :label="'Amount'|trans">${{ totals.amount|number_format(2, '.', ',') }}</twig:StatCard>
        </div>
    </div>

    <div class="card">
        <div class="table-responsive">
            <table class="table table-vcenter card-table">
                <thead>
                    <tr>
                        <th>{{ 'Date'|trans }}</th>
                        <th>{{ 'Project'|trans }}</th>
                        <th>{{ 'Description'|trans }}</th>
                        <th>{{ 'Tags'|trans }}</th>
                        <th>{{ 'Start'|trans }}</th>
                        <th>{{ 'End'|trans }}</th>
                        <th class="text-end">{{ 'Duration'|trans }}</th>
                        <th class="text-center">$</th>
                    </tr>
                </thead>
                <tbody>
                    {% for entry in entries %}
                        <tr>
                            <td>{{ entry.dateStart ? entry.dateStart.format('M j, Y') : '—' }}</td>
                            <td>
                                {% if entry.project %}
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="status-dot" style="--swp-status-color: {{ entry.project.color }}"></span>
                                        <span>{{ entry.project.name }}</span>
                                        {% if entry.project.client %}
                                            <span class="text-secondary">· {{ entry.project.client.name }}</span>
                                        {% endif %}
                                    </div>
                                {% else %}
                                    <span class="text-secondary">—</span>
                                {% endif %}
                            </td>
                            <td>{{ entry.description ?: ('(no description)'|trans) }}</td>
                            <td>{% include 'components/_tag_chips.html.twig' with {tags: entry.tags} only %}</td>
                            <td class="font-monospace text-tabular">{{ entry.dateStart ? entry.dateStart.format('H:i') : '—' }}</td>
                            <td class="font-monospace text-tabular">{{ entry.dateEnd ? entry.dateEnd.format('H:i') : '—' }}</td>
                            <td class="text-end font-monospace text-tabular">
                                <time>{{ entry.duration ? format_interval(entry.duration, true) : '—' }}</time>
                            </td>
                            <td class="text-center">
                                {% if entry.billable %}
                                    {{ ux_icon('tabler:currency-dollar', {class: 'icon text-warning-emphasis'}) }}
                                {% else %}
                                    <span class="text-secondary">—</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="8" class="text-center text-secondary py-4">
                                {{ 'No time entries match the selected filters.'|trans }}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        {% include 'components/_pagination.html.twig' %}
    </div>
</div>
