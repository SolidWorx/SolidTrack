{% set week_hours = stats.week_total.totalHours %}
{% set billable_hours = stats.week_billable.totalHours %}
{% set week_goal = 40 %}
{% set week_pct = week_hours > 0 ? (week_hours / week_goal * 100)|round : 0 %}
{% set billable_pct = week_hours > 0 ? (billable_hours / week_hours * 100)|round : 0 %}

<div {{ attributes.defaults({class: 'row row-cards'}) }}>

    <div class="col-sm-6 col-xl-3">
        <twig:StatCard :label="'Today'|trans" :hint="'Tracked today'|trans">
            <time>{{ format_interval(stats.today_total, true) }}</time>
        </twig:StatCard>
    </div>

    <div class="col-sm-6 col-xl-3">
        <twig:StatCard :label="'This week'|trans">
            <time>{{ format_interval(stats.week_total, true) }}</time>
            <span class="fs-4 fw-normal text-secondary">/ {{ week_goal }}h</span>

            <twig:block name="footer">
                <div class="progress progress-sm" role="progressbar"
                     aria-valuenow="{{ week_pct }}" aria-valuemin="0" aria-valuemax="100"
                     aria-label="{{ 'Weekly progress'|trans }}">
                    <div class="progress-bar" style="width: {{ min(week_pct, 100) }}%"></div>
                </div>
            </twig:block>
        </twig:StatCard>
    </div>

    <div class="col-sm-6 col-xl-3">
        <twig:StatCard :label="'Billable'|trans" tone="text-warning-emphasis">
            <time>{{ format_interval(stats.week_billable, true) }}</time>

            <twig:block name="footer">
                <div class="{{ billable_pct >= 50 ? 'text-success' : 'text-secondary' }}">
                    {{ billable_pct }}% {{ 'of tracked'|trans }}
                </div>
            </twig:block>
        </twig:StatCard>
    </div>

    <div class="col-sm-6 col-xl-3">
        {% if stats.week_earnings is empty %}
            <twig:StatCard :label="'Earnings · estimate'|trans"
                           :hint="'No billable rate set'|trans"
                           tone="text-secondary"
                           :numeric="false">—</twig:StatCard>
        {% else %}
            <twig:StatCard :label="'Earnings · estimate'|trans" tone="text-primary">
                {% for currency, amount in stats.week_earnings|slice(0, 1, true) %}
                    {{ amount|format_currency(currency) }}
                {% endfor %}

                <twig:block name="footer">
                    {% for currency, amount in stats.week_earnings|slice(1, null, true) %}
                        <div class="text-secondary">+ {{ amount|format_currency(currency) }}</div>
                    {% endfor %}
                    <div class="text-secondary">{{ 'This week'|trans }}</div>
                </twig:block>
            </twig:StatCard>
        {% endif %}
    </div>

</div>
