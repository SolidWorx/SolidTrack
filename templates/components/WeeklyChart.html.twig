<div {{ attributes }}>
    <div class="card">
        <div class="card-header">
            <div>
                <h3 class="card-title">{{ 'Weekly activity'|trans }}</h3>
                <p class="card-subtitle">
                    <time>{{ format_interval(totals.total, true) }}</time> {{ 'tracked'|trans }}
                </p>
            </div>
            {# The middle segment stays clickable: disabling it on the current week
               would grey out the widget's most prominent label by default. #}
            <div class="card-actions">
                <div class="nav nav-segmented nav-sm" role="group" aria-label="{{ 'Week'|trans }}">
                    <button type="button"
                            class="nav-link"
                            {{ live_action('previousWeek') }}
                            aria-label="{{ 'Previous week'|trans }}"
                            title="{{ 'Previous week'|trans }}">
                        {{ ux_icon('tabler:chevron-left', {class: 'icon'}) }}
                    </button>
                    <button type="button"
                            class="nav-link active"
                            {{ live_action('currentWeek') }}
                            title="{{ weekOffset == 0 ? 'This week'|trans : 'Jump to current week'|trans }}">
                        {{ weekOffset == 0 ? 'This week'|trans : rangeLabel }}
                    </button>
                    <button type="button"
                            class="nav-link"
                            {{ live_action('nextWeek') }}
                            aria-label="{{ 'Next week'|trans }}"
                            title="{{ 'Next week'|trans }}">
                        {{ ux_icon('tabler:chevron-right', {class: 'icon'}) }}
                    </button>
                </div>
            </div>
        </div>
        <div class="card-body">
            <div class="row g-2 mb-3">
                <div class="col">
                    <div class="subheader">{{ 'Total'|trans }}</div>
                    <div class="h2 mb-0 font-monospace text-tabular">
                        <time>{{ format_interval(totals.total, true) }}</time>
                    </div>
                </div>
                <div class="col text-end">
                    <div class="subheader">{{ 'Billable'|trans }}</div>
                    <div class="h2 mb-0 font-monospace text-tabular text-warning-emphasis">
                        <time>{{ format_interval(totals.billable, true) }}</time>
                    </div>
                </div>
            </div>

            <div style="height: 180px">
                {{ render_chart(chart, {style: 'width: 100%; height: 100%;'}) }}
            </div>

            {# Painted from the chart's palette, not a `bg-*` utility — the
               non-billable bars are drawn at 40% alpha. #}
            <div class="d-flex justify-content-center gap-4 mt-2 text-secondary">
                <span class="d-inline-flex align-items-center gap-1">
                    <span class="legend" style="background: {{ legendColors.billable }}"></span>
                    {{ 'Billable'|trans }}
                </span>
                <span class="d-inline-flex align-items-center gap-1">
                    <span class="legend" style="background: {{ legendColors.nonBillable }}"></span>
                    {{ 'Non-billable'|trans }}
                </span>
            </div>
        </div>
    </div>
</div>
