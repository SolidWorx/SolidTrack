<div {{ attributes }}>
    <div class="card">
        <div class="card-header">
            <div>
                <h3 class="card-title">{{ 'Top projects'|trans }}</h3>
                <p class="card-subtitle">
                    {{ 'This week'|trans }} ·
                    <time>{{ format_interval(topProjects.total, true) }}</time> {{ 'tracked'|trans }}
                </p>
            </div>
            <div class="card-actions">
                <a href="{{ path('app_project_index') }}">{{ 'View all'|trans }}</a>
            </div>
        </div>
        <div class="card-body">
            {% if topProjects.projects is empty %}
                <p class="text-secondary text-center mb-0">{{ 'No tracked time this week.'|trans }}</p>
            {% else %}
                <div class="d-flex flex-column gap-3">
                    {% for row in topProjects.projects %}
                        <div>
                            <div class="d-flex align-items-center justify-content-between mb-1">
                                <span class="d-inline-flex align-items-center gap-2 text-truncate">
                                    <span class="status-dot" style="--swp-status-color: {{ row.project.color }}"></span>
                                    <span class="text-truncate">{{ row.project.name }}</span>
                                </span>
                                <span class="fw-bold font-monospace text-tabular">
                                    <time>{{ format_interval(row.duration, true) }}</time>
                                </span>
                            </div>
                            <div class="progress progress-sm" role="progressbar"
                                 aria-valuenow="{{ row.percent|number_format(0) }}"
                                 aria-valuemin="0" aria-valuemax="100"
                                 aria-label="{{ row.project.name }} share">
                                <div class="progress-bar"
                                     style="width: {{ row.percent }}%; --swp-progress-bar-bg: {{ row.project.color }}"></div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </div>
</div>
