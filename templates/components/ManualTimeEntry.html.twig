<div {{ attributes.defaults({id: 'manual-time-entry-form'}) }}
     data-project-clients="{{ projectClients|json_encode }}">
    {{ form_start(form, {
        attr: {
            'data-action': 'live#action:prevent',
            'data-live-action-param': 'save',
        },
    }) }}

        {{ form_row(form.description, {'attr': {'autocomplete': 'off'}}) }}

        <div class="row g-3">
            {# TomSelect owns the DOM inside these two wrappers, so Live must not
               morph them — same arrangement as the tracker bar. The modal-prefill
               controller talks to TomSelect's own API to seed the project. #}
            <div class="col-md-6">
                <label class="form-label" for="{{ form.project.vars.id }}">{{ 'Project'|trans }}</label>
                <div data-live-ignore>
                    {{ form_widget(form.project) }}
                </div>
            </div>
            <div class="col-md-6">
                <label class="form-label" for="{{ form.tags.vars.id }}">{{ 'Tags'|trans }}</label>
                <div data-live-ignore>
                    {{ form_widget(form.tags) }}
                </div>
            </div>
        </div>

        <div class="row g-3 mt-0">
            <div class="col-md-6">
                {{ form_row(form.dateStart) }}
            </div>
            <div class="col-md-6">
                {{ form_row(form.dateEnd) }}
                {% if duration %}
                    <div class="form-hint text-end">
                        {{ ux_icon('tabler:clock', {class: 'icon icon-sm'}) }}
                        <time>{{ format_interval(duration) }}</time>
                    </div>
                {% endif %}
            </div>
        </div>

        <div class="mt-3">
            {{ form_row(form.billable) }}
        </div>

        {# The action row lives inside the component, not the modal's footer block:
           a button outside the component root would be beyond Live's reach. #}
        <div class="d-flex mt-4 pt-3 border-top">
            <button type="button" class="btn me-auto" data-bs-dismiss="modal">
                {{ 'Cancel'|trans }}
            </button>
            <button type="submit" class="btn btn-primary">
                {{ ux_icon('tabler:plus', {class: 'icon'}) }}
                {{ 'Add entry'|trans }}
            </button>
        </div>

    {{ form_end(form) }}
</div>
