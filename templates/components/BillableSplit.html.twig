<div {{ attributes }}>
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">{{ 'Billable split'|trans }}</h3>
            <div class="card-actions text-secondary">{{ 'This week'|trans }}</div>
        </div>
        <div class="card-body">
            <div class="progress mb-3" role="progressbar"
                 aria-valuenow="{{ split.billablePct }}" aria-valuemin="0" aria-valuemax="100"
                 aria-label="{{ 'Billable share'|trans }}">
                <div class="progress-bar bg-warning" style="width: {{ split.billablePct }}%"></div>
            </div>

            <div class="row g-3">
                <div class="col-6">
                    <div class="d-flex align-items-center gap-1 text-secondary mb-1">
                        <span class="legend bg-warning"></span>
                        <span class="text-truncate">{{ 'Billable'|trans }}</span>
                        <span class="ms-auto font-monospace text-tabular">{{ split.billablePct }}%</span>
                    </div>
                    <div class="fw-bold font-monospace text-tabular">
                        <time>{{ format_interval(split.billable, true) }}</time>
                    </div>
                </div>
                <div class="col-6">
                    <div class="d-flex align-items-center gap-1 text-secondary mb-1">
                        <span class="legend"></span>
                        <span class="text-truncate">{{ 'Non-billable'|trans }}</span>
                        <span class="ms-auto font-monospace text-tabular">{{ 100 - split.billablePct }}%</span>
                    </div>
                    <div class="fw-bold font-monospace text-tabular text-secondary">
                        <time>{{ format_interval(split.nonBillable, true) }}</time>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
