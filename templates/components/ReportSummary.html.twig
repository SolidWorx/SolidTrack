<div {{ attributes }}>
    {% include 'components/_report_filters.html.twig' with {showGroupBy: true} %}

    <div class="row row-cards mb-3">
        <div class="col-sm-6 col-xl-3">
            <twig:StatCard :label="'Total time'|trans"
                           :hint="'%count% entries'|trans({'%count%': totals.entries})">
                <time>{{ format_interval(totals.total, true) }}</time>
            </twig:StatCard>
        </div>
        <div class="col-sm-6 col-xl-3">
            <twig:StatCard :label="'Billable'|trans" tone="text-primary">
                <time>{{ format_interval(totals.billable, true) }}</time>
            </twig:StatCard>
        </div>
        <div class="col-sm-6 col-xl-3">
            <twig:StatCard :label="'Non-billable'|trans" tone="text-warning-emphasis">
                <time>{{ format_interval(totals.nonBillable, true) }}</time>
            </twig:StatCard>
        </div>
        <div class="col-sm-6 col-xl-3">
            <twig:StatCard :label="'Amount'|trans">${{ totals.amount|number_format(2, '.', ',') }}</twig:StatCard>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body">
            <div style="height: 220px">
                {{ render_chart(chart, {style: 'width: 100%; height: 100%;'}) }}
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h3 class="card-title">{{ 'Breakdown'|trans }}</h3>
        </div>
        <div class="table-responsive">
            <table class="table table-vcenter card-table">
                <thead>
                    <tr>
                        <th>{{ 'Name'|trans }}</th>
                        <th class="text-end">{{ 'Total'|trans }}</th>
                        <th class="text-end">{{ 'Billable'|trans }}</th>
                        <th class="text-end">{{ 'Amount'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for groupIndex, group in groups %}
                        {# Stable per-row IDs so morphdom can reconcile rows when
                           the group/child count changes (e.g. on tag toggle).
                           Without IDs, morphdom falls back to positional
                           matching and duplicates rows on Live re-renders. #}
                        <tr id="rs-g-{{ groupIndex }}" class="fw-bold">
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    {% if group.color %}
                                        <span class="status-dot" style="--swp-status-color: {{ group.color }}"></span>
                                    {% endif %}
                                    <span>{{ group.label }}</span>
                                    {% if group.sub %}
                                        <span class="text-secondary fw-normal">· {{ group.sub }}</span>
                                    {% endif %}
                                    {% include 'components/_tag_chips.html.twig' with {tags: group.tags} only %}
                                </div>
                            </td>
                            <td class="text-end font-monospace text-tabular"><time>{{ group.totalHours|number_format(2) }}h</time></td>
                            <td class="text-end font-monospace text-tabular"><time>{{ group.billableHours|number_format(2) }}h</time></td>
                            <td class="text-end font-monospace text-tabular">${{ group.amount|number_format(2, '.', ',') }}</td>
                        </tr>
                        {% for childIndex, child in group.children %}
                            <tr id="rs-g-{{ groupIndex }}-c-{{ childIndex }}">
                                <td class="ps-5 text-secondary">
                                    <div class="d-flex align-items-center gap-2 flex-wrap">
                                        <span>↳ {{ child.label }}</span>
                                        {% include 'components/_tag_chips.html.twig' with {tags: child.tags} only %}
                                    </div>
                                </td>
                                <td class="text-end font-monospace text-tabular">{{ child.totalHours|number_format(2) }}h</td>
                                <td class="text-end font-monospace text-tabular">{{ child.billableHours|number_format(2) }}h</td>
                                <td class="text-end font-monospace text-tabular">${{ child.amount|number_format(2, '.', ',') }}</td>
                            </tr>
                        {% endfor %}
                    {% else %}
                        <tr>
                            <td colspan="4" class="text-center text-secondary py-4">
                                {{ 'No time entries match the selected filters.'|trans }}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
