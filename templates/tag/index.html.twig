{% extends 'layouts/base.html.twig' %}

{% block page_title %}{{ 'Tags'|trans }}{% endblock %}

{% block page_title_actions %}
    <a href="{{ path('app_tag_new') }}" class="btn btn-primary d-none d-sm-inline-flex">
        {{ ux_icon('tabler:text-plus', {class: 'icon'}) }}
        {{ 'Create new tag'|trans }}
    </a>
    <a href="{{ path('app_tag_new') }}" class="btn btn-primary btn-icon d-sm-none" aria-label="{{ 'Create new tag'|trans }}">
        {{ ux_icon('tabler:plus', {class: 'icon'}) }}
    </a>
{% endblock %}

{% block content %}
    <div class="card">
        <div class="table-responsive">
            <table class="table table-vcenter card-table">
                <thead>
                    <tr>
                        <th>{{ 'Name'|trans }}</th>
                        <th class="w-1">{{ 'Actions'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for tag in tags %}
                        <tr>
                            <td>
                                <span class="status-dot align-middle me-2" style="--swp-status-color: {{ tag.color }}" aria-label="{{ tag.color }}"></span>
                                {{ tag.name }}
                            </td>
                            <td>
                                <div class="btn-list flex-nowrap">
                                    <a href="{{ path('app_tag_edit', {'id': tag.id}) }}" class="btn btn-sm">
                                        {{ ux_icon('tabler:pencil', {class: 'icon'}) }}
                                        {{ 'Edit'|trans }}
                                    </a>
                                    {{ include('tag/_delete_form.html.twig', {tag: tag}) }}
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="2" class="text-center text-secondary py-4">{{ 'No records found'|trans }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
