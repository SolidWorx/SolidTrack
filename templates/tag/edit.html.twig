{% extends 'layouts/base.html.twig' %}

{% block page_pretitle %}{{ 'Tags'|trans }}{% endblock %}
{% block page_title %}{{ 'Edit :tag'|trans({':tag': tag}) }}{% endblock %}

{% block page_title_actions %}
    {{ include('tag/_delete_form.html.twig', {tag: tag}) }}
{% endblock %}

{% block content %}
    <div class="card">
        <div class="card-body">
            {{ form_start(form, {'attr': {'id': 'form_' ~ form.vars.name}}) }}
            {{ form_widget(form) }}
            {{ form_end(form) }}
        </div>
        <div class="card-footer d-flex">
            <a href="{{ path('app_tag_index') }}" class="btn">
                {{ ux_icon('tabler:arrow-back', {class: 'icon'}) }}
                {{ 'Cancel'|trans }}
            </a>
            <button class="btn btn-primary ms-auto" type="submit" form="{{ 'form_' ~ form.vars.name }}">
                {{ ux_icon('tabler:device-floppy', {class: 'icon'}) }}
                {{ button_label|default('Save') }}
            </button>
        </div>
    </div>
{% endblock %}
