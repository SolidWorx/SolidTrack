{% extends 'layouts/base.html.twig' %}

{% set hour = 'now'|date('G') %}
{% set greeting = hour < 12 ? 'Good morning'|trans : (hour < 18 ? 'Good afternoon'|trans : 'Good evening'|trans) %}
{% set display_name = app.user.firstName ?: (app.user.email|split('@')|first) %}

{# The dashboard's figures are all scoped to the current (Monday-start) week, so
   the header action drills into the detailed report for exactly that range. #}
{% set week_from = 'monday this week'|date('Y-m-d') %}
{% set week_to = 'sunday this week'|date('Y-m-d') %}

{% block page_header %}
    <div class="page-header">
        <div class="container-xl">
            <section class="st-pagehead">
                <div>
                    <h1 class="st-pagehead-title">{{ greeting }}, {{ display_name }}</h1>
                    <p class="st-pagehead-sub">{{ 'now'|date('l, F j, Y') }}</p>
                </div>
                <div class="st-pagehead-actions">
                    <a href="{{ path('app_report_index', {type: 'detailed', from: week_from, to: week_to}) }}"
                       class="st-btn st-btn-primary">
                        <span class="ic">{{ ux_icon('tabler:calendar', {'width': '14', 'height': '14'}) }}</span>
                        {{ "This week's report"|trans }}
                    </a>
                </div>
            </section>
        </div>
    </div>
{% endblock %}

{% block content %}
    <twig:TimeTracker />

    <div style="margin-top: 18px;">
        <twig:DashboardStats />
    </div>

    <div style="display: grid; grid-template-columns: minmax(0, 1fr) 360px; gap: 18px; margin-top: 18px;">
        <div>
            <twig:UserActivity />
        </div>
        <div style="display: flex; flex-direction: column; gap: 14px;">
            <twig:WeeklyChart />
            <twig:TopProjects />
            <twig:BillableSplit />
        </div>
    </div>
{% endblock content %}
