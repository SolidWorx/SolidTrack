{% extends 'layouts/base.html.twig' %}

{% set hour = 'now'|date('G') %}
{% set greeting = hour < 12 ? 'Good morning'|trans : (hour < 18 ? 'Good afternoon'|trans : 'Good evening'|trans) %}
{% set display_name = app.user.firstName ?: (app.user.email|split('@')|first) %}

{# The dashboard's figures are all scoped to the current (Monday-start) week, so
   the header action drills into the detailed report for exactly that range. #}
{% set week_from = 'monday this week'|date('Y-m-d') %}
{% set week_to = 'sunday this week'|date('Y-m-d') %}

{% block page_pretitle %}{{ 'now'|date('l, F j, Y') }}{% endblock %}
{% block page_title %}{{ greeting }}, {{ display_name }}{% endblock %}

{% block page_title_actions %}
    {{ include('components/_manual_entry_button.html.twig') }}
    <a href="{{ path('app_report_index', {type: 'detailed', from: week_from, to: week_to}) }}"
       class="btn btn-primary">
        {{ ux_icon('tabler:calendar', {class: 'icon'}) }}
        {{ "This week's report"|trans }}
    </a>
{% endblock %}

{% block content %}
    <twig:TimeTracker />

    <div class="row row-cards mt-3">
        <div class="col-12">
            <twig:DashboardStats />
        </div>

        <div class="col-lg-8">
            <twig:UserActivity />
        </div>

        <div class="col-lg-4">
            <div class="row row-cards">
                <div class="col-12"><twig:WeeklyChart /></div>
                <div class="col-12"><twig:TopProjects /></div>
                <div class="col-12"><twig:BillableSplit /></div>
            </div>
        </div>
    </div>

    {{ include('components/_manual_entry_modal.html.twig') }}
{% endblock content %}
